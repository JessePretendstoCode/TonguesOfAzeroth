<Bindings>
    <!--
        Switching in and out of character happens mid-conversation, several
        times a session: you duck out to answer a raid leader and duck back.
        That is keybind territory, not a trip to the options panel.

        The actions call globals rather than the addon namespace because
        Blizzard runs these bodies as plain chunks with no addon scope.

        Note for editors: XML forbids a double hyphen inside a comment, so
        keep the prose here free of them.
    -->
    <Binding name="TONGUESOFAZEROTH_TOGGLE_IC" header="TONGUESOFAZEROTH" category="ADDONS">
        TonguesOfAzeroth_ToggleInCharacter()
    </Binding>
    <Binding name="TONGUESOFAZEROTH_NEXT_LANG" category="ADDONS">
        TonguesOfAzeroth_CycleLanguage(1)
    </Binding>
    <Binding name="TONGUESOFAZEROTH_PREV_LANG" category="ADDONS">
        TonguesOfAzeroth_CycleLanguage(-1)
    </Binding>
</Bindings>
